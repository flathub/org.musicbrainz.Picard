{
    "name": "python3-plugin-deps",
    "buildsystem": "simple",
    "build-commands": [],
    "modules": [
        {
            "name": "python3-OpenCC",
            "buildsystem": "simple",
            "build-options": {
                "env": {
                    "CFLAGS": "-I/usr/include/python3.13",
                    "CXXFLAGS": "-I/usr/include/python3.13"
                }
            },
            "build-commands": [
                "pip3 install --verbose --exists-action=i --no-index --find-links=\"file://${PWD}\" --prefix=${FLATPAK_DEST} \"opencc\" --no-build-isolation"
            ],
            "sources": [
                {
                    "type": "file",
                    "url": "https://files.pythonhosted.org/packages/e0/12/09e62f051af1de7ca84be1d69154bd0514416ef72237e2081584cc268bc9/opencc-1.4.2.tar.gz",
                    "sha256": "47977905f131d7d9cfcec29fba5d841154907e1da73103105a4a68744e0f4f1a",
                    "x-checker-data": {
                        "type": "pypi",
                        "name": "OpenCC"
                    }
                }
            ],
            "cleanup": [
                "/bin",
                "/share/man/man1"
            ]
        },
        {
            "name": "python3-zstandard",
